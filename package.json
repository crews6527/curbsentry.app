{
  "name": "curbsentry-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "dev": "npm run prepare:ocr && vite --host 127.0.0.1 --port 8080",
    "build": "npm run prepare:ocr && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/create-test-videos.mjs && node scripts/browser-smoke.mjs",
    "test:browser:dev": "npm run prepare:ocr && node scripts/create-test-videos.mjs && node scripts/browser-smoke.mjs --dev",
    "test:desktop:browser": "node scripts/create-test-videos.mjs && node scripts/desktop-browser-smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "0.510.0",
    "zustand": "5.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "6.0.5",
    "@tailwindcss/vite": "4.3.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "playwright": "1.62.0"
  }
}
